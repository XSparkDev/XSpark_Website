# Local reference only. Do NOT commit real secrets.
# For Supabase Edge Function deployment, set these as Supabase secrets (server-side):
#   supabase secrets set LLM_API_KEY=... LLM_BASE_URL=... LLM_MODEL=... [LLM_FALLBACK_MODEL=...] --project-ref <ref>
#
# Example (Groq / OpenAI-compatible):
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_MODEL=llama-3.1-8b-instant

API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FALLBACK_MODEL=
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,https://www.xspark.co.za
# Optional for local file testing only (not for production): add ,null to ALLOWED_ORIGINS if you open X Spark.html directly as file://
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,https://www.xspark.co.za,null
# Trust X-Forwarded-For for rate limiting. Default false (use real socket IP). Set true only behind a trusted proxy/load balancer that sets the real client IP.
TRUST_PROXY=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=
